{
  "name": "ardu-backend",
  "version": "1.0.0",
  "description": "Backend API for motivational quotes app with AI-powered recommendations",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "migrate": "node migrations/run.js",
    "seed": "node seeds/run.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "docker:reset": "docker compose down -v && docker compose up -d && sleep 5 && npm run migrate && npm run seed",
    "dev:docker": "docker compose up -d && sleep 5 && npm run migrate && npm run dev"
  },
  "keywords": ["quotes", "motivation", "ai", "ollama", "push-notifications"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "expo-server-sdk": "^3.7.0",
    "node-cron": "^3.0.3",
    "ollama": "^0.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.1",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
