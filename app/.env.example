# Copy to .env and adjust. Never commit .env.

# Backend URL.
# iOS simulator: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical phone: http://<your computer's LAN IP>:3000
API_BASE_URL=http://localhost:3000

# Optional: real AdMob IDs for release builds. Leave empty to use Google's
# test ads (always used in dev builds anyway).
ADMOB_APP_ID_IOS=
ADMOB_APP_ID_ANDROID=
ADMOB_BANNER_ID_IOS=
ADMOB_BANNER_ID_ANDROID=

# Optional: your own EAS project ID, only needed for EAS builds.
EAS_PROJECT_ID=
